# Agent execution context: local setup writes local; hosted sessions inject sandbox.
COMWIT_EXECUTION_ENV=local

# MCP project context. USER_ID is optional; absent/empty means the AI author.
COMWIT_PROJECT_ID=
USER_ID=

# Cloud resource context written by the Comwit project handoff (a different ID).
COMWIT_PROJECT=
# Optional during initialization and DB/Storage setup; required for deployment.
COMWIT_APP=

# Cloud login credential exported without printing by:
# comwit auth export-token --env-out .env
# The preconfigured MCP bridge uses this credential; no separate MCP PAT is needed.
# Never expose credentials through NEXT_PUBLIC_*, client responses, or logs.
COMWIT_CLOUD_TOKEN=

# Optional persistent resource bindings. Project handoff resolves the stored
# binding through Cloud and the matching setup skill merges fresh Cloud values
# here. Handoff treats its project payload as the authoritative snapshot and
# removes stale local resource keys omitted by that snapshot while preserving
# the token and unrelated keys. Never copy these values into tracked source.
# Leave both database keys empty when the project does not use a database.
COMWIT_DATABASE_ID=
DATABASE_URL=

# Leave the Storage group empty when the project does not use Storage.
# PUBLIC_BASE_URL may stay empty for private or still-provisioning Storage.
COMWIT_STORAGE_ID=
COMWIT_STORAGE_ENDPOINT=
COMWIT_STORAGE_BUCKET=
COMWIT_STORAGE_PUBLIC_BASE_URL=

# Template-specific values. Use different auth secrets for every project/environment.
APP_URL=http://localhost:3000
# 배포 주소(https://….app.comwit.link 또는 커스텀 도메인). 로컬에서 빌드해 배포할 때 sitemap·og:url 기준이 된다.
SITE_URL=
APP_AUTH_SECRET=
ADMIN_AUTH_SECRET=
# Complete public path, e.g. /관리자-a1b2c3d4e5 or /운영실.
# pnpm admin:path initializes an unset/default path once; restart/rebuild after changes.
NEXT_PUBLIC_ADMIN_BASE_PATH=
PLATFORM_NAME=강의 플랫폼
# 미결제 주문 자동 만료(분), 수강생 환불 신청 가능 기간(일), 환불 신청을 막는 진도율(%)
ORDER_EXPIRY_MINUTES=30
REFUND_WINDOW_DAYS=7
REFUND_PROGRESS_LIMIT=30
# 토스페이먼츠 결제위젯. test_/live_ 키 접두어가 PAYMENT_MODE 와 일치해야 한다.
PAYMENT_MODE=test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MID=
# /cron/* 유지보수 경로의 X-Comwit-Cron-Secret 헤더 값
COURSE_CRON_SECRET=

# Optional one-time administrator provisioning, only on an explicit request.
# pnpm admin:create reads these and removes them from the local .env after success.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
